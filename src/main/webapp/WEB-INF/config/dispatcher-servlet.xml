<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context
                           http://www.springframework.org/schema/context/spring-context.xsd
                           http://www.springframework.org/schema/mvc
                           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- Controller 및 ControllerAdvice 스캔 (Service/DAO는 context-common.xml에서 스캔) -->
    <context:component-scan base-package="com.stuedit.web, com.stuedit.common"/>

    <!-- MVC 기본 설정 (@RequestMapping, Validator 등 자동 등록) -->
    <mvc:annotation-driven/>

    <!-- 정적 리소스 처리 (css, js, images) -->
    <mvc:resources mapping="/resources/**" location="/resources/"/>

    <!-- ===================== Tiles ViewResolver ===================== -->
    <bean id="tilesConfigurer"
          class="org.springframework.web.servlet.view.tiles3.TilesConfigurer">
        <property name="definitions">
            <list>
                <!-- Tiles 레이아웃 정의 파일 -->
                <value>/WEB-INF/config/tiles/tiles-definitions.xml</value>
            </list>
        </property>
    </bean>

    <bean id="tilesViewResolver"
          class="org.springframework.web.servlet.view.tiles3.TilesViewResolver">
        <!-- InternalResourceViewResolver보다 우선 처리 -->
        <property name="order" value="1"/>
    </bean>

    <!--
        JSP ViewResolver (Tiles 정의에 없는 뷰 처리용 fallback)
        prefix/suffix로 JSP 경로 자동 조합
    -->
    <bean id="viewResolver"
          class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="order"  value="2"/>
        <property name="prefix" value="/WEB-INF/jsp/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

    <!-- 파일 업로드: MultipartResolver (10MB 제한) -->
    <bean id="multipartResolver"
          class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
        <!-- 최대 파일 크기: 10MB -->
        <property name="maxUploadSize" value="10485760"/>
        <property name="defaultEncoding" value="UTF-8"/>
    </bean>

    <!-- 기본 예외 처리 (예외 → 에러 뷰 매핑) -->
    <!-- eGovFrame 4.x에서 SimpleAnnotationExceptionHandlerResolver 제거됨 → Spring 표준 사용 -->
    <bean class="org.springframework.web.servlet.handler.SimpleMappingExceptionResolver">
        <property name="order" value="1"/>
        <property name="defaultErrorView" value="common/error"/>
        <property name="exceptionMappings">
            <props>
                <prop key="java.lang.Exception">common/error</prop>
            </props>
        </property>
    </bean>

</beans>
