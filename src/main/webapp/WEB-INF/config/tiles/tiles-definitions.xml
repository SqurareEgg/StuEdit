<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC
    "-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN"
    "http://tiles.apache.org/dtds/tiles-config_3_0.dtd">

<tiles-definitions>

    <!-- ===================== 기본 레이아웃 템플릿 ===================== -->
    <definition name="layout" template="/WEB-INF/jsp/common/layout.jsp">
        <put-attribute name="header"  value="/WEB-INF/jsp/common/header.jsp"/>
        <put-attribute name="sidebar" value="/WEB-INF/jsp/common/sidebar.jsp"/>
        <put-attribute name="footer"  value="/WEB-INF/jsp/common/footer.jsp"/>
        <put-attribute name="body"    value=""/>
    </definition>

    <!-- ===================== 메인 대시보드 ===================== -->
    <definition name="main" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/common/main.jsp"/>
    </definition>

    <!-- ===================== 학생 관리 ===================== -->
    <definition name="student/list"   extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/student/studentList.jsp"/>
    </definition>
    <definition name="student/detail" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/student/studentDetail.jsp"/>
    </definition>
    <definition name="student/insertForm" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/student/studentInsertForm.jsp"/>
    </definition>
    <definition name="student/updateForm" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/student/studentUpdateForm.jsp"/>
    </definition>

    <!-- ===================== 사용자/보안 ===================== -->
    <!-- 로그인은 레이아웃 없이 단독 페이지 -->
    <definition name="user/login" template="/WEB-INF/jsp/user/login.jsp"/>

    <definition name="user/mypage" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/user/mypage.jsp"/>
    </definition>
    <definition name="user/pwChange" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/user/pwChange.jsp"/>
    </definition>

    <!-- ===================== 성적 관리 ===================== -->
    <definition name="grade/list" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/grade/gradeList.jsp"/>
    </definition>
    <definition name="grade/insertForm" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/grade/gradeInsertForm.jsp"/>
    </definition>
    <definition name="grade/updateForm" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/grade/gradeUpdateForm.jsp"/>
    </definition>

    <!-- ===================== 출결 관리 ===================== -->
    <definition name="attend/list" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/attend/attendList.jsp"/>
    </definition>
    <definition name="attend/insertForm" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/attend/attendInsertForm.jsp"/>
    </definition>
    <definition name="attend/updateForm" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/attend/attendInsertForm.jsp"/>
    </definition>

    <!-- ===================== 공지사항 ===================== -->
    <definition name="notice/list" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/notice/noticeList.jsp"/>
    </definition>
