    <definition name="survey/list" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/survey/surveyList.jsp"/>
    </definition>
    <definition name="survey/participate" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/survey/surveyParticipate.jsp"/>
    </definition>
    <definition name="survey/result" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/survey/surveyResult.jsp"/>
    </definition>
    <definition name="survey/insertForm" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/survey/surveyInsertForm.jsp"/>
    </definition>

    <!-- ===================== 학사 일정 ===================== -->
    <definition name="schedule/list" extends="layout">
