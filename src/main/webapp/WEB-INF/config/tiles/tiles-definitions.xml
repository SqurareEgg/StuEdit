        <put-attribute name="body" value="/WEB-INF/jsp/notice/noticeDetail.jsp"/>
    </definition>
    <definition name="notice/insertForm" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/notice/noticeInsertForm.jsp"/>
    </definition>
    <definition name="notice/updateForm" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/notice/noticeUpdateForm.jsp"/>
    </definition>

    <!-- ===================== 1:1 문의 ===================== -->
    <definition name="inquiry/list" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/inquiry/inquiryList.jsp"/>
    </definition>
    <definition name="inquiry/detail" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/inquiry/inquiryDetail.jsp"/>
