    </definition>

    <!-- ===================== 챗봇 ===================== -->
    <definition name="chatbot/chat" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/chatbot/chat.jsp"/>
    </definition>

    <!-- ===================== 공통 에러 ===================== -->
    <definition name="common/error" extends="layout">
        <put-attribute name="body" value="/WEB-INF/jsp/common/error.jsp"/>
    </definition>

</tiles-definitions>
